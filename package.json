{
  "name": "bandeira-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "build": "ng build docs",
    "postbuild": "node scripts/spa-fallback.mjs",
    "build:lib": "ng build bandeira-ui && node scripts/copy-lib-meta.mjs",
    "watch:lib": "ng build bandeira-ui --watch --configuration development",
    "test": "ng test bandeira-ui --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test bandeira-ui",
    "pack:lib": "npm run build:lib && npm pack ./dist/bandeira-ui --pack-destination ./dist",
    "release": "npm run build:lib && npm publish ./dist/bandeira-ui --access public",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,json}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "prettier": "3.4.2",
    "typescript": "~5.9.2"
  }
}
