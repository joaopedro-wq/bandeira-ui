  "license": "MIT",
  "homepage": "https://joaopedro-wq.github.io/bandeira-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaopedro-wq/bandeira-ui.git"
  },
  "bugs": {
    "url": "https://github.com/joaopedro-wq/bandeira-ui/issues"
  },
  "peerDependencies": {
    "@angular/cdk": ">=20.0.0",
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0",
    "@angular/forms": ">=20.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
